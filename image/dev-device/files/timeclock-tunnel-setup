#!/bin/sh
# Set up the reverse SSH tunnel that lets Coolify on the VPS reach this host (Decided 29): this host
# dials timeclock-backend's tunnel container and forwards REMOTE_PORT there to its own SSH server.
# Usage: sudo timeclock-tunnel-setup [REMOTE_PORT] [VPS_HOST] [VPS_TUNNEL_PORT]
set -eu
REMOTE_PORT=${1:-22001}
VPS=${2:-108.61.75.238}
TUNNEL_PORT=${3:-2223}
D=/etc/timeclock

[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
install -d -m 700 "$D"
[ -f "$D/tunnel_key" ] || ssh-keygen -q -t ed25519 -N '' -C "$(hostname)-tunnel" -f "$D/tunnel_key"

ssh-keyscan -t ed25519 -p "$TUNNEL_PORT" "$VPS" > "$D/known_hosts.new" 2>/dev/null
[ -s "$D/known_hosts.new" ] || { rm -f "$D/known_hosts.new"; echo "could not reach $VPS:$TUNNEL_PORT" >&2; exit 1; }
echo "The tunnel's host key. Compare with the fingerprint in the timeclock-tunnel container's log in Coolify:"
ssh-keygen -lf "$D/known_hosts.new"
printf 'Does it match? [y/N] '
read -r answer
[ "$answer" = y ] || { rm -f "$D/known_hosts.new"; echo "aborted" >&2; exit 1; }
mv "$D/known_hosts.new" "$D/known_hosts"

cat > /etc/systemd/system/coolify-tunnel.service <<EOF
[Unit]
Description=Reverse SSH tunnel so Coolify on the VPS can reach this host
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -p $TUNNEL_PORT -i $D/tunnel_key -o UserKnownHostsFile=$D/known_hosts -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 0.0.0.0:$REMOTE_PORT:localhost:22 tctunnel@$VPS
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now coolify-tunnel

echo
echo "Add this line to docker/tunnel/authorized_keys in timeclock-backend, commit, push and redeploy:"
printf 'restrict,port-forwarding,permitlisten="0.0.0.0:%s" %s\n' "$REMOTE_PORT" "$(cat "$D/tunnel_key.pub")"
echo "Then add a server in Coolify at timeclock-tunnel, port $REMOTE_PORT, user root."
echo "The tunnel retries every 10 s until it's accepted: systemctl status coolify-tunnel"
